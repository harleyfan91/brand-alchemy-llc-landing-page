{
  "name": "brand-alchemy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pdf:sample": "npm run generate --workspace=@brand-alchemy/pdf-shell-sample",
    "pdf:cafe": "npm run generate:cafe --workspace=@brand-alchemy/pdf-shell-sample",
    "pdf:cafe-photos": "npm run generate:cafe-photos --workspace=@brand-alchemy/pdf-shell-sample",
    "pdf:audit": "npm run generate:audit --workspace=@brand-alchemy/pdf-shell-sample",
    "pdf:gym": "npm run generate:gym --workspace=@brand-alchemy/pdf-shell-sample",
    "pdf:gym-photos": "npm run generate:gym-photos --workspace=@brand-alchemy/pdf-shell-sample",
    "pdf:services": "npm run generate:services --workspace=@brand-alchemy/pdf-shell-sample",
    "pdf:services-photos": "npm run generate:services-photos --workspace=@brand-alchemy/pdf-shell-sample",
    "pdf:spa": "npm run generate:spa --workspace=@brand-alchemy/pdf-shell-sample",
    "pdf:spa-photos": "npm run generate:spa-photos --workspace=@brand-alchemy/pdf-shell-sample"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
