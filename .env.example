# Optional: where the Identity Kit intake app starts (full URL).
# Examples:
#   https://kit.brandalchemyllc.com
#   https://brandalchemyllc.com/identity-kit/start   (after you proxy that path to the kit app)
# If unset, `VITE_IDENTITY_KIT_URL` or the default kit subdomain is used.
# VITE_IDENTITY_KIT_START_URL=

# Optional: base URL for the kit app when START is not set (no trailing slash).
# VITE_IDENTITY_KIT_URL=https://kit.brandalchemyllc.com

# Optional: direct tier-specific start URLs for the selector page.
# If unset, Brand Alchemy will fall back to `VITE_IDENTITY_KIT_START_URL` and append `?tier=core` or `?tier=pro`.
# VITE_IDENTITY_KIT_CORE_START_URL=
# VITE_IDENTITY_KIT_PRO_START_URL=

# Guides & launch kits — checkout URLs (optional). Unset = “Coming soon” in the matrix on /local-business.
# VITE_GOOGLE_CORE_KIT_CHECKOUT_URL=
# VITE_GOOGLE_PRO_KIT_CHECKOUT_URL=
# VITE_YELP_CORE_KIT_CHECKOUT_URL=
# VITE_YELP_PRO_KIT_CHECKOUT_URL=
# VITE_LOCAL_KITS_BUNDLE_CHECKOUT_URL=
